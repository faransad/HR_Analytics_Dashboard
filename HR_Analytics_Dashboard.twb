      <column aggregation='None' caption='Age (bin)' datatype='integer' name='[Age (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='0' formula='[Age]' peg='0' size-parameter='[Parameters].[Parameter 1]' />
      </column>
      <column datatype='integer' name='[Age]' role='measure' type='quantitative' />
      <column caption='Attrition Count' datatype='integer' name='[Attrition]' role='measure' type='quantitative' />
      <column caption='Attrition Rate' datatype='real' name='[Calculation_945122658220982272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Attrition]) / COUNT([Employee_ID])' />
      </column>
      <column aggregation='Sum' caption='Job Satisfaction' datatype='integer' name='[Calculation_945122658221137921]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Performance Rating] = &quot;Needs Improvement&quot; THEN 1&#10;ELSEIF [Performance Rating] = &quot;Satisfactory&quot; THEN 2&#10;ELSEIF [Performance Rating] = &quot;Good&quot; THEN 3&#10;ELSEIF [Performance Rating] = &quot;Excellent&quot; THEN 4&#10;END' />
      </column>
      <column caption='Age Band' datatype='string' name='[Calculation_945122658221260802]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Age] &lt; 25 THEN &quot;&lt;25&quot;&#10;ELSEIF [Age] &lt;= 34 THEN &quot;25-34&quot;&#10;ELSEIF [Age] &lt;= 44 THEN &quot;35-44&quot;&#10;ELSE &quot;45+&quot;&#10;END' />
      </column>
      <column caption='Active Employees' datatype='integer' name='[Calculation_945122658221572099]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Employee_ID])- SUM([Attrition])' />
      </column>
